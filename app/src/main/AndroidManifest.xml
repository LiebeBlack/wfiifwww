<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== Red ===================== -->
    <!-- Sockets TCP/UDP, ping, DNS y descargas de descripciones UPnP. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Estado de la conexión: saber si hay Wi-Fi, VPN o datos móviles. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Leer SSID/BSSID, DHCP y el estado del adaptador Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Activar/desactivar el Wi-Fi desde los accesos directos de la app. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- MulticastLock: sin este permiso el driver filtra multicast y SSDP,
         WS-Discovery y mDNS no recibirían ninguna respuesta. Es un permiso
         normal, concedido al instalar. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 13+: acceso a información de redes Wi-Fi cercanas. Se declara
         con neverForLocation (concedido al instalar) para poder leer el SSID
         también cuando el usuario prefiere no compartir ubicación. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- ===================== Ubicación ===================== -->
    <!-- Android exige ubicación para leer el nombre real de la red (SSID) y
         los datos DHCP. Se solicita en tiempo de ejecución. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ===================== Teléfono ===================== -->
    <!-- Permiso normal (sin diálogo) con el estado básico del teléfono, útil
         en ROMs que lo consultan al enumerar interfaces de red. -->
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />
    <!-- Declarado para completar el conjunto de conectividad: la app nunca
         solicita identificadores ni datos personales del teléfono. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- La app funciona en tablets y TVs sin Wi-Fi gracias a Ethernet/USB. -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <application
        android:name=".WifiScannerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WifiScanner"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <!-- HTTP sin cifrar está permitido únicamente porque UPnP publica la
             descripción del dispositivo en una URL http:// de la red local.
             No se envía ni se recibe nada fuera de la LAN. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
