<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== Networking ===================== -->
    <!-- Raw sockets / ping sweep / DNS lookups. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read Wi-Fi connection info (SSID, DHCP info -> local IP/netmask). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Monitor connectivity state to know when we're on Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Changelog: change Wi-Fi state (used to toggle the scan-friendly multicast lock). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- ===================== Location ===================== -->
    <!-- Android gates all Wi-Fi scan results behind location permission.
         FINE is required to *start* scans on API 29+; we request at runtime. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Coarse is implied by FINE but declared explicitly for clarity on API 31+. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ===================== Android 13+ runtime notification permission (optional UX) =========== -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- We never *require* BLE; NEARBY_WIFI_DEVICES with neverForLocation keeps
         Android 13+ happy if we later add Wi-Fi Aware/Rtt. Declared with
         maxSdkVersion so older devices use the location path only. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <application
        android:name=".WifiScannerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WifiScanner"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|uiMode|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
