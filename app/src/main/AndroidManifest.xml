<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== Networking ===================== -->
    <!-- Raw sockets / ping sweep / DNS lookups. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read Wi-Fi connection info (SSID, DHCP info -> local IP/netmask). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Monitor connectivity state to know when we're on Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required for WifiManager.MulticastLock: without it the Wi-Fi driver
         filters multicast frames and SSDP, WS-Discovery and mDNS hear nothing.
         This is a normal permission, granted at install time. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- ===================== Location ===================== -->
    <!-- Android gates all Wi-Fi scan results behind location permission.
         FINE is required to *start* scans on API 29+; we request at runtime. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Coarse is implied by FINE but declared explicitly for clarity on API 31+. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- NEARBY_WIFI_DEVICES is intentionally NOT declared: the scanner reads
         connection info and DHCP leases, which are gated by location, and it
         does not use Wi-Fi Aware/RTT. Asking for it at runtime only added a
         permission that could be denied and block the scanner for no reason. -->

    <application
        android:name=".WifiScannerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WifiScanner"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|uiMode|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
