    <!-- Permission rationale strings shown before the system dialog. -->
    <string name="permission_rationale_title">Permiso de ubicación</string>
    <string name="permission_rationale_body">Android exige el permiso de ubicación para leer el nombre real de la red Wi-Fi y la dirección IP local. El análisis se realiza íntegramente en el dispositivo: no se envía nada a ningún servidor.</string>
    <string name="permission_denied_title">Permiso denegado</string>
    <string name="permission_denied_body">El análisis necesita el permiso de ubicación para mostrar el nombre de la red. Puede volver a solicitarlo o concederlo desde los ajustes del sistema.</string>
    <string name="permission_location_off_title">Active la ubicación</string>
    <string name="permission_location_off_body">El permiso está concedido, pero la ubicación del sistema está desactivada. Android oculta el nombre de la red (SSID) mientras siga apagada.</string>
